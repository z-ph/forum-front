    "element-plus": "^2.14.0",
    "md-editor-v3": "^6.5.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.4",
    "unplugin-vue-router": "^0.19.2",
