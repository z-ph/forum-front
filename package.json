{
  "name": "forum-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint . --cache --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-strategy content",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
